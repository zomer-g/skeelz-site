# Local development. On xhostd these are set with set_env (secrets with secret=true).

# Postgres. xhostd injects DATABASE_URL per channel; locally: `npm run db:local` (PGlite on 5435).
DATABASE_URL=postgresql://postgres@127.0.0.1:5435/postgres

# Auth — XHOST SSO. The whole app is admin-only while it is a preview.
ADMIN_EMAILS=
# Hostnames the identity cookie may be minted for (comma separated).
XHOST_AUTH_AUDIENCES=
# next dev only: impersonate this email (there is no xhostd edge on localhost).
DEV_AUTH_EMAIL=

# Job feed from the admin app: GET ${ADMIN_API_URL}/api/v1/site/jobs (Bearer SITE_FEED_TOKEN).
# Leave ADMIN_API_URL unset locally to use the committed fixture (src/data/fixture-jobs.json).
ADMIN_API_URL=
SITE_FEED_TOKEN=

# CRM intake for the sandbox apply form: POST ${CRM_URL}/api/intake/applications (Bearer CRM_INTAKE_TOKEN).
# Locally: `npm run stub:crm` and CRM_URL=http://127.0.0.1:3299
CRM_URL=
CRM_INTAKE_TOKEN=
